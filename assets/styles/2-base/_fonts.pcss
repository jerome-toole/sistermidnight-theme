/* ---------------------------------------------------------------------------
 * Fonts
 *
 * Self-hosted from assets/static/fonts/. Wired to the theme in
 * 1-theme/_tailwind-theme.pcss and preloaded in Theme/Modules/Core/Preloads.php:
 *   --font-display   Sister Midnight     hero, headings, titles
 *   --font-sans      FOSS Modern Bold    body, labels, buttons
 * ------------------------------------------------------------------------- */

/* A single heavy cut, declared as bold (700) so display text counts as
   bold for WCAG large-text contrast (bold >= 19px needs 3:1, not 4.5:1).
   Only one face exists, so nothing is synthesised either way */
@font-face {
    font-display: fallback;
    font-family: "SisterMidnight";
    font-style: normal;
    font-weight: 700;
    src: url("/fonts/sister-midnight-regular.woff2") format("woff2");
}

/* Only the Bold cut exists: declared across the full weight range so
   normal and bold text both use it without synthesised bolding */
@font-face {
    font-display: fallback;
    font-family: "FOSS Modern";
    font-style: normal;
    font-weight: 100 900;
    src: url("/fonts/foss-modern-bold.woff2") format("woff2");
}
