@font-face {
    font-family: 'SisterMidnight';
    src: url('/subset-SisterMidnight-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: fallback;
}

@font-face {
    font-family: 'Rework';
    src: url('/subset-ReworkText-RegularItalic.woff2') format('woff2');
    font-weight: normal;
    font-style: italic;
    font-display: fallback;
    font-feature-settings: "lnum";
}

@font-face {
    font-family: 'Rework';
    src: url('/subset-ReworkText-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: fallback;
    font-feature-settings: "lnum";
}

@font-face {
    font-family: 'Rework';
    src: url('/subset-ReworkText-Semibold.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: fallback;
    font-feature-settings: "lnum";
}

@font-face {
    font-family: 'Rework';
    src: url('/subset-ReworkText-SemiboldItalic.woff2') format('woff2');
    font-weight: 600;
    font-style: italic;
    font-display: fallback;
    font-feature-settings: "lnum";
}

@font-face {
    font-family: 'Rework';
    src: url('/subset-ReworkText-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: fallback;
    font-feature-settings: "lnum";
}
