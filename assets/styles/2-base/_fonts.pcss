@font-face {
    font-family: 'PTSerif';
    src: url('/subset-PTSerif-Italic.woff2') format('woff2');
    font-weight: normal;
    font-style: italic;
    font-display: fallback;
}

@font-face {
    font-family: 'PTSerif';
    src: url('/subset-PTSerif-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: fallback;
}

@font-face {
    font-family: 'National';
    src: url('/subset-National-Semibold.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: fallback;
    font-feature-settings: "lnum";
}

@font-face {
    font-family: 'National';
    src: url('/subset-National-RegularItalic.woff2') format('woff2');
    font-weight: normal;
    font-style: italic;
    font-display: fallback;
    font-feature-settings: "lnum";
}

@font-face {
    font-family: 'National';
    src: url('/subset-National-Regular.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: fallback;
    font-feature-settings: "lnum";
}

