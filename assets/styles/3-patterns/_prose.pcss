@utility prose {
    // First child never has top margin
    > :first-child {
        margin-top: 0;
    }

    // Block element spacing (top-margin only)
    :where(p, ul, ol, table, iframe, embed, hr, address, pre, dl, fieldset) {
        margin-top: var(--space--base);
    }

    // Heading spacing (top-margin only)
    :where(h1, h2, h3, h4, h5, h6) {
        margin-top: var(--heading--margin-top);
    }

    // List item spacing
    :where(li + li) {
        margin-top: var(--list--item--spacing);
    }

    // Nested list spacing
    :where(li > :is(ol, ul)) {
        margin-top: var(--list--item--spacing);
    }

    // Definition list spacing
    :where(dd + dt) {
        margin-top: var(--list--item--spacing);
    }
}

@utility not-prose {
    :where(p, ul, ol, table, iframe, embed, hr, address, pre, dl, fieldset),
    :where(h1, h2, h3, h4, h5, h6),
    :where(li + li),
    :where(li > :is(ol, ul)),
    :where(dd + dt) {
        margin-top: 0;
    }
}

/* Re-enable prose inside not-prose */
.not-prose .prose {
    :where(p, ul, ol, table, iframe, embed, hr, address, pre, dl, fieldset) {
        margin-top: var(--space--base);
    }

    :where(h1, h2, h3, h4, h5, h6) {
        margin-top: var(--heading--margin-top);
    }

    :where(li + li),
    :where(li > :is(ol, ul)),
    :where(dd + dt) {
        margin-top: var(--list--item--spacing);
    }
}
