/* Link
 *
 * Applied to every <a> in 2-base/_type-elements.pcss.
 *
 * Colour knobs are never declared on :root, so a colour context or parent can set them:
 *   --link--color         falls back to --color-accent
 *   --link--color-hover   falls back to --link--color mixed toward the foreground
 *
 * The underline thickens on hover, so there's feedback even where the accent
 * and the foreground are the same colour (e.g. dark-umber on stone-beige).
 */

@utility link {
    color: var(--link--color, var(--color-accent));
    text-decoration: var(--link--text-decoration);
    text-decoration-thickness: var(--link--text-decoration-thickness, 1px);
    transition: transition(color, text-decoration-color, text-decoration-thickness);

    @media (hover: hover) {
        &:hover {
            color: var(
                --link--color-hover,
                color-mix(in oklab, var(--link--color, var(--color-accent)) 75%, var(--color-foreground))
            );
            text-decoration: var(--link--text-decoration--hover);
            text-decoration-thickness: var(--link--text-decoration-thickness--hover, 2px);
        }
    }
    @media (hover: none) {
        &:active {
            color: var(
                --link--color-hover,
                color-mix(in oklab, var(--link--color, var(--color-accent)) 75%, var(--color-foreground))
            );
            text-decoration: var(--link--text-decoration--hover);
            text-decoration-thickness: var(--link--text-decoration-thickness--hover, 2px);
        }
    }
}

@utility link--2 {
    --link--text-decoration: none;
    --link--text-decoration--hover: underline;
}

@utility link--foreground {
    --link--color: var(--color-foreground);
    --link--color-hover: var(--color-foreground);
}

/* External link (opens in a new tab)
 *
 * Added by Gust\Components\Link whenever target="_blank": the label is followed
 * by a visually hidden "(opens in new tab)" and the ↗ arrow (`.link-external__icon`,
 * the Button arrow rotated). The icon scales with the font size; the gap and
 * icon size can be tuned per context.
 */
@utility link-external {
    --link-external--gap: 0.3em;
    --link-external--icon-size: 0.7em;

    display: inline-flex;
    align-items: center;
    gap: var(--link-external--gap);

    .link-external__icon {
        flex: 0 0 auto;
        width: var(--link-external--icon-size);
        height: var(--link-external--icon-size);
        transition: transition(transform);
    }

    @media (hover: hover) {
        &:hover .link-external__icon {
            transform: translate(10%, -10%);
        }
    }
    @media (hover: none) {
        &:active .link-external__icon {
            transform: translate(10%, -10%);
        }
    }
}
