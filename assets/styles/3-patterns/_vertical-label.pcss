/* --------------------------------------------------- */
/* Vertical label
 *
 * Section label in the left gutter ("Upcoming", "About us", "Objectives").
 * Horizontal below md; from md it runs top-to-bottom (writing-mode only,
 * no rotation: the first letter sits at the top, as in the design).
 * DOM and reading order are unchanged.
 */
/* --------------------------------------------------- */

@utility vertical-label {
    display: block;
    width: max-content;
    max-width: 100%;

    @media (width >= theme("screens.md")) {
        max-width: none;
        max-height: 100%;
        text-wrap: nowrap;
        writing-mode: vertical-lr;
    }
}

/* Sticks below the viewport top (and admin bar) from md while its grid area
 * scrolls past. The grid item needs align-self: start (the grids do). */
@utility sticky-label {
    @media (width >= theme("screens.md")) {
        position: sticky;
        top: calc(var(--wp-admin--admin-bar--height, 0px) + spaceFluid(24, 40));
    }
}
