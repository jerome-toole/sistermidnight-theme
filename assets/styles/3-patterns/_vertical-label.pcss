/* --------------------------------------------------- */
/* Vertical label
 *
 * Section label in the left gutter ("Upcoming", "About us", "Objectives").
 * Horizontal below md; from md it runs top-to-bottom (writing-mode only,
 * no rotation: the first letter sits at the top, as in the design).
 * DOM and reading order are unchanged.
 */
/* --------------------------------------------------- */

@utility vertical-label {
    display: block;
    width: max-content;
    max-width: 100%;

    @media (width >= theme("screens.md")) {
        max-width: none;
        max-height: 100%;
        text-wrap: nowrap;
        writing-mode: vertical-lr;
    }
}
