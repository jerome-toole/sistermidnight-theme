// ---------------------------------------------------
// Type Style Mixins
// ---------------------------------------------------

@utility sistermidnight-attributes {
    font-family: var(--font-sistermidnight);
    font-weight: 400;
    line-height: 1.3;
}

@utility rework-attributes {
    font-family: var(--font-rework);
    font-weight: 400;
}

@utility type-base {
    @apply rework-attributes;

    line-height: 1.3;
    font-weight: 400;
    font-size: rfs(17, 18);
    letter-spacing: 0.02em;
}

@utility type-small {
    @apply rework-attributes;

    font-size: rem(16);
    line-height: 1.375;
}

@utility type-meta {
    @apply rework-attributes;

    font-size: var(--type--font-size--base);
    line-height: 1.2;
}

@utility type-caption {
    @apply rework-attributes;

    font-size: rem(16);
    line-height: 1.375;
}

@utility type-hero {
    @apply sistermidnight-attributes;

    font-size: rfs(30, 48);
}

@utility type-h1 {
    @apply sistermidnight-attributes;

    font-size: rfs(32, 54);
}

@utility type-h2 {
    @apply sistermidnight-attributes;

    font-size: rfs(26, 34);
}

@utility type-h3 {
    @apply rework-attributes;

    font-size: rfs(20, 24);
}

@utility type-h4 {
    @apply rework-attributes;

    line-height: 1.3;
    font-size: rfs(17, 19);
    letter-spacing: 0.02em;
}

@utility type-h5 {
    @apply rework-attributes;

    line-height: 1.3;
    font-size: rfs(14, 16);
    letter-spacing: 0.02em;
}

@utility type-h6 {
    @apply rework-attributes;

    font-size: var(--type--font-size--base);
}

// WordPress Block Style Classes
.is-style-type-hero {
    @apply type-hero;
}

.is-style-type-h1 {
    @apply type-h1;
}

.is-style-type-h2 {
    @apply type-h2;
}

.is-style-type-h3 {
    @apply type-h3;
}

.is-style-type-h4 {
    @apply type-h4;
}

.is-style-type-h5 {
    @apply type-h5;
}

.is-style-type-h6 {
    @apply type-h6;
}

.is-style-type-small {
    @apply type-small;
}

.is-style-type-meta {
    @apply type-meta;
}
