/* --------------------------------------------------- */
/* Type Style Mixins
 *
 * Sizes are theme tokens (--text-h1 …, see 1-theme/_tailwind-theme.pcss),
 * each carrying its line height and letter spacing.
 *
 *   type-hero                      Sister Midnight: large display titles
 *   type-h1 … type-h6              Sister Midnight: headings
 *   type-title, type-title-sm      Sister Midnight caps: event and promo card titles
 *   type-large, type-lead          FOSS Modern: splash and intro text
 *   type-base, type-small          FOSS Modern: body
 *   type-label, type-label-sm      FOSS Modern: nav, buttons, arrows
 *   type-meta, type-caption        FOSS Modern, small: footer, captions, credits
 *   type-code                      Monospace, small: code blocks
 */
/* --------------------------------------------------- */

@utility display-heading-attributes {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold); /* matches the single 700 cut in 2-base/_fonts.pcss */
    text-wrap: balance;
}

@utility sans-attributes {
    font-family: var(--font-sans);
    font-weight: var(--font-weight-bold);
}

@utility type-large {
    @apply sans-attributes;

    font-size: var(--text-large);
    letter-spacing: var(--text-large--letter-spacing);
    line-height: var(--text-large--line-height);
}

@utility type-lead {
    @apply sans-attributes;

    font-size: var(--text-lead);
    letter-spacing: var(--text-lead--letter-spacing);
    line-height: var(--text-lead--line-height);
}

@utility type-base {
    @apply sans-attributes;

    font-size: var(--text-base);
    letter-spacing: var(--text-base--letter-spacing);
    line-height: var(--text-base--line-height);
}

@utility type-body {
    @apply type-base;
}

@utility type-small {
    @apply sans-attributes;

    font-size: var(--text-small);
    letter-spacing: var(--text-small--letter-spacing);
    line-height: var(--text-small--line-height);
}

@utility type-caption {
    @apply type-small;
}

@utility type-label {
    @apply sans-attributes;

    font-size: var(--text-label);
    letter-spacing: var(--text-label--letter-spacing);
    line-height: var(--text-label--line-height);
}

@utility type-label-sm {
    @apply sans-attributes;

    font-size: var(--text-label-sm);
    letter-spacing: var(--text-label-sm--letter-spacing);
    line-height: var(--text-label-sm--line-height);
}

@utility type-meta {
    @apply sans-attributes;

    font-size: var(--text-meta);
    letter-spacing: var(--text-meta--letter-spacing);
    line-height: var(--text-meta--line-height);
}

@utility type-code {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--text-code--letter-spacing);
    line-height: var(--text-code--line-height);
}

@utility type-hero {
    @apply display-heading-attributes;

    font-size: var(--text-hero);
    letter-spacing: var(--text-hero--letter-spacing);
    line-height: var(--text-hero--line-height);
}

@utility type-h1 {
    @apply display-heading-attributes;

    font-size: var(--text-h1);
    letter-spacing: var(--text-h1--letter-spacing);
    line-height: var(--text-h1--line-height);
}

@utility type-h2 {
    @apply display-heading-attributes;

    font-size: var(--text-h2);
    letter-spacing: var(--text-h2--letter-spacing);
    line-height: var(--text-h2--line-height);
}

@utility type-h3 {
    @apply display-heading-attributes;

    font-size: var(--text-h3);
    letter-spacing: var(--text-h3--letter-spacing);
    line-height: var(--text-h3--line-height);
}

@utility type-h4 {
    @apply display-heading-attributes;

    font-size: var(--text-h4);
    letter-spacing: var(--text-h4--letter-spacing);
    line-height: var(--text-h4--line-height);
}

@utility type-h5 {
    @apply display-heading-attributes;

    font-size: var(--text-h5);
    letter-spacing: var(--text-h5--letter-spacing);
    line-height: var(--text-h5--line-height);
}

@utility type-h6 {
    @apply display-heading-attributes;

    font-size: var(--text-h6);
    letter-spacing: var(--text-h6--letter-spacing);
    line-height: var(--text-h6--line-height);
}

@utility type-title {
    @apply display-heading-attributes;

    font-size: var(--text-title);
    letter-spacing: var(--text-title--letter-spacing);
    line-height: var(--text-title--line-height);
    text-transform: uppercase;
}

@utility type-title-sm {
    @apply display-heading-attributes;

    font-size: var(--text-title-sm);
    letter-spacing: var(--text-title-sm--letter-spacing);
    line-height: var(--text-title-sm--line-height);
    text-transform: uppercase;
}

/* WordPress Block Style Classes */
.is-style-type-hero {
    @apply type-hero;
}

.is-style-type-h1 {
    @apply type-h1;
}

.is-style-type-h2 {
    @apply type-h2;
}

.is-style-type-h3 {
    @apply type-h3;
}

.is-style-type-h4 {
    @apply type-h4;
}

.is-style-type-h5 {
    @apply type-h5;
}

.is-style-type-h6 {
    @apply type-h6;
}

.is-style-type-title {
    @apply type-title;
}

.is-style-type-title-sm {
    @apply type-title-sm;
}

.is-style-type-large {
    @apply type-large;
}

.is-style-type-lead {
    @apply type-lead;
}

.is-style-type-small {
    @apply type-small;
}

.is-style-type-meta {
    @apply type-meta;
}

.is-style-type-label {
    @apply type-label;
}
