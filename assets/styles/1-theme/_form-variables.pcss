// ---------------------------------------------------
// Form Variables
// ---------------------------------------------------

@layer base {
    :root {
        --input--color: var(--color-warm-black);
        --input--border-color: var(--color-warm-black);
        --input--background-color: var(--color-white);
        --input--background-color--highlight: hsl(
            var(--color-warm-black--h),
            var(--color-warm-black--s),
            90%
        );
        --input--color-focus:  var(--color-warm-black);
        --input--outline-color--focus: var(--input--border-color);
        --input--background-color--focus: var(--color-white);
        --input--placeholder-color: var(--input--color);

        --input--border-width: 1px;
        --input--border-radius: 1.45em;
        --input--outline-width--focus: 1px;
        --input--gap: space(8);
        --input--padding-y: rem(11);
        --input--padding-x: rem(16);
        --input--padding: var(--input--padding-y) var(--input--padding-x);

        --form--label-spacing: space(8);

        --form--textarea-height: 100px;

        --checkbox--size: rem(16);
        --checkbox--padding: .125em;
        --checkbox--border-width: 1px;

        --checkbox--check-size: calc(var(--checkbox--size) - (var(--checkbox--padding) * 2));
        --checkbox--check-stroke: 2px;
        --checkbox--border-radius: 0;

        --radio--size: rem(16);
        --radio--padding: calc(var(--radio--size) / 4);
        --radio--border-width: 1px;
    }
}
