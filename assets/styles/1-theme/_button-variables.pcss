/* Button Variables */

@layer base {
    :root {
        // --btn--font-size: rfs(18, 22);

        --btn--padding-y: 0.15em;
        --btn--padding-x: 0.525em;

        --btn--border-width: var(--border-width--s);
        --btn--border-radius: 999px;

        --btn--color: var(--color-slate);
        --btn--background-color: var(--color-beige);
        --btn--border-color: var(--color-beige);

        --btn--color-hover: var(--color-slate);
        --btn--background-color--hover: hsla(
            var(--color-beige--h),
            var(--color-beige--s),
            calc(var(--color-beige--l) - 5%)
        );
        --btn--border-color--hover: hsla(
            var(--color-beige--h),
            var(--color-beige--s),
            calc(var(--color-beige--l) - 5%)
        );

        --btn--color--selected: var(--color-neutral);
        --btn--background-color--selected: var(--color-grey);
        --btn--border-color--selected: var(--color-grey);

        --btn--gap: 0.5em;

        // Small Button
        --btn--small--padding-y: 0;
        --btn--small--padding-x: 0.7em;
    }
}
