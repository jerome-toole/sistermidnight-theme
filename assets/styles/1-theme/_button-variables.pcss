/* Button Variables */

@layer base {
    :root {
        // --btn--font-size: rfs(18, 22);

        --btn--padding-y: 0.15em;
        --btn--padding-x: 0.525em;

        --btn--border-width: var(--border-width--s);
        --btn--border-radius: 999px;

        --btn--color: var(--colorwarm-black);
        --btn--background-color: var(--color-off-white);
        --btn--border-color: var(--color-off-white);

        --btn--color-hover: var(--colorwarm-black);
        --btn--background-color--hover: hsla(
            var(--color-off-white--h),
            var(--color-off-white--s),
            calc(var(--color-off-white--l) - 5%)
        );
        --btn--border-color--hover: hsla(
            var(--color-off-white--h),
            var(--color-off-white--s),
            calc(var(--color-off-white--l) - 5%)
        );

        --btn--color--selected: var(--color-off-white);
        --btn--background-color--selected: var(--color-warm-grey);
        --btn--border-color--selected: var(--color-warm-grey);

        --btn--gap: 0.5em;

        // Small Button
        --btn--small--padding-y: 0;
        --btn--small--padding-x: 0.7em;
    }
}
