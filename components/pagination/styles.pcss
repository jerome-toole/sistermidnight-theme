/* ---------------------------------------------------------------------------
 * Pagination
 *
 * Centred row of paper squares (stone-beige, dark-umber text); the current
 * page is burnt-sienna with cool-grey text (4.5:1). Previous / next are
 * paper buttons with their text label.
 * ------------------------------------------------------------------------- */

.pagination {
    --pagination--size: space(40);
    --pagination--gap: space(8);

    margin-block-start: spaceFluid(32, 48);
}

.pagination .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--pagination--gap);

    > .page-numbers {
        @apply type-h6;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: var(--pagination--size);
        min-height: var(--pagination--size);
        padding-inline: space(12);
        line-height: 1;
        text-decoration: none;
    }

    > a.page-numbers {
        @apply color-context-stone-beige;

        text-decoration: underline;
        text-decoration-color: transparent;
        text-underline-offset: 0.15em;
        transition: text-decoration-color 0.2s;

        &:hover {
            text-decoration-color: currentcolor;
        }

        &:focus-visible {
            outline: var(--base--focus-width, 2px) solid var(--focus--color);
            outline-offset: -5px; /* inset, on the paper */
        }
    }

    > .current {
        @apply color-context-burnt-sienna;

        color: var(--color-cool-grey);
    }

    > .dots {
        padding-inline: 0;
    }
}
