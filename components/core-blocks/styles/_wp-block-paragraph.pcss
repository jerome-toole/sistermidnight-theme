/* stylelint-disable selector-no-qualifying-type */

/* Paragraph block. Block styles "Large" (type-large, intro copy) and "Small"
 * (type-small, legal) map to the .is-style-type-* classes that
 * 3-patterns/_type-styles.pcss already defines. */

p {
    &.has-background {
        padding: var(--space-base) spaceFluid(12, 16);
    }
}
