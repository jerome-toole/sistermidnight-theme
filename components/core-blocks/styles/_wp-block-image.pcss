/* Image block. Default: square corners, as in the design. Block style
 * "Framed": a thin rule in the foreground colour with an inset, like a
 * mounted print. */

.wp-block-image {
    @apply media-embed;

    > img {
        margin: 0 auto;
    }

    &.is-style-framed {
        > img,
        > a > img,
        > figure > img {
            padding: space(12);
            border: 1px solid color-mix(in oklab, var(--color-foreground) 60%, transparent);
        }
    }
}
