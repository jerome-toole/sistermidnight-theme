.wp-block-group {
    @apply margin-trim;

    &.has-background {
        padding-block: var(--space--layout);
    }

    &.alignfull {
        @apply page-grid;
    }

    &.is-layout-grid {
        display: grid;
        row-gap: var(--row-gap);

        @media (width < theme('screens.lg')) {
            grid-template-columns: 1fr;
        }

        @media (width >= theme('screens.lg')) {
            column-gap: var(--col-gap);

            > * {
                margin-block: 0;
            }
        }
    }
}
