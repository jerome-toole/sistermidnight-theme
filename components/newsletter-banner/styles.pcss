/* ---------------------------------------------------------------------------
 * Newsletter banner
 *
 * Stone-beige band (padding 40 above and below, 64 at the sides from md, 16
 * below): heading, text and the Newsletter Form on the left, a 240px
 * illustration on the right that overhangs the band's padding so it adds no
 * height (design: 266 tall). Below md the illustration is hidden and the
 * content stacks.
 * ------------------------------------------------------------------------- */

.newsletter-banner {
    --newsletter-banner--padding: space(40);
    --newsletter-banner--padding-x: space(16);
    --newsletter-banner--illustration-size: space(240);

    @apply color-context-stone-beige;

    padding: var(--newsletter-banner--padding) var(--newsletter-banner--padding-x);

    @media (width >= theme('screens.md')) {
        --newsletter-banner--padding-x: space(64);
    }
}

/* After a stone-beige section (news single) the band is dark, as in the design */
.newsletter-banner--dark-umber {
    @apply color-context-dark-umber;
}

.newsletter-banner__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: space(32);
}

.newsletter-banner__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    /* 20 (design 26/31) keeps the band at the design's 266 with the built line heights */
    gap: space(20);
    max-width: space(541);
}

.newsletter-banner__heading {
    @apply type-h3;
}

.newsletter-banner__text {
    @apply type-body;

    max-width: space(436);
}

/* Decorative, so simply dropped on small screens */
.newsletter-banner__illustration {
    display: none;

    @media (width >= theme('screens.md')) {
        display: block;
        flex: none;
        width: var(--newsletter-banner--illustration-size);
        margin-block: calc(var(--newsletter-banner--padding) * -1);
        margin-inline-end: space(52);
    }
}
