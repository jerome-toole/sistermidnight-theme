{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "theme/gallery",
    "title": "Gallery",
    "description": "Images with a vertical label, as a masonry grid or a horizontal carousel (block styles).",
    "category": "theme-blocks",
    "icon": "format-gallery",
    "keywords": ["gallery", "images", "carousel", "slider", "masonry"],
    "textdomain": "gust",
    "styles": [
        { "name": "masonry", "label": "Masonry", "isDefault": true },
        { "name": "carousel", "label": "Carousel" }
    ],
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "renderCallback": "Gust\\Components\\Gallery::renderBlock"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "mode": false,
        "jsx": false,
        "html": false,
        "color": {
            "background": false,
            "text": false,
            "gradients": false
        }
    }
}
