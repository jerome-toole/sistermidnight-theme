:where(.instagram-feed) {
    padding-block: var(--space-lg);
}

:where(.instagram-feed__grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gutter, 1rem);
}

:where(.instagram-feed__item) {
    display: block;
    position: relative;
    overflow: hidden;
    transition: opacity 150ms ease;
}

:where(.instagram-feed__item:hover) {
    opacity: 0.85;
}

:where(.instagram-feed__image) {
    img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
    }
}

:where(.instagram-feed__link) {
    display: inline-block;
    margin-block-start: var(--space-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
}

@media (min-width: theme('screens.sm')) {
    :where(.instagram-feed__grid) {
        grid-template-columns: repeat(3, 1fr);
    }
}
