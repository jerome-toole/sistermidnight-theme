:where(.instagram-feed) {
    padding-block: space(32);
}

.instagram-feed__grid {
    --col-gap: space(8);
    --row-gap: space(8);
}

:where(.instagram-feed__item) {
    display: block;
    position: relative;
    overflow: hidden;
    transition: opacity 150ms ease;
}

:where(.instagram-feed__item:hover) {
    opacity: 0.85;
}

:where(.instagram-feed__item) {
    img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4/5;
        object-fit: cover;
    }
}

:where(.instagram-feed__link) {
    display: inline-block;
    margin-block-start: space(16);
    text-decoration: underline;
    text-underline-offset: 0.2em;
}
