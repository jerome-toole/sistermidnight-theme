{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "theme/press-links",
    "title": "Press Links",
    "category": "theme-blocks",
    "icon": "media-document",
    "keywords": [
        "press",
        "media",
        "articles",
        "coverage",
        "news"
    ],
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "postTypes": [
            "page",
            "gust-template"
        ],
        "renderCallback": "Gust\\Components\\PressLinks::renderBlock"
    },
    "supports": {
        "anchor": true,
        "align": [
            "wide",
            "full"
        ],
        "color": {
            "background": true,
            "text": false,
            "gradients": false
        }
    }
}
