:where(.press-links) {
    padding-block: space(32);
}

:where(.press-links__heading) {
    margin-block-end: space(24);
}

:where(.press-links__list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: space(16);
}

:where(.press-links__item) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: space(8) space(16);
    padding-block: space(8);
    border-bottom: 1px solid currentColor;
    opacity: 0.9;
}

:where(.press-links__item:last-child) {
    border-bottom: none;
}

:where(.press-links__date) {
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    flex-shrink: 0;
    min-width: 6rem;
}

:where(.press-links__link) {
    font-weight: 500;
    text-decoration: none;
    transition: opacity 150ms ease;
}

:where(.press-links__link:hover) {
    opacity: 0.7;
}

@media (min-width: 640px) {
    :where(.press-links__item) {
        flex-wrap: nowrap;
    }
}
