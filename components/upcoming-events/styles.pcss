/* ---------------------------------------------------------------------------
 * Upcoming Events (block)
 *
 * Full-width band with the page gutter as side padding: the vertical label
 * (left gutter, rotated from md) and the Event Cards in one or two lists.
 *
 *   grid      One list in date order (announcement card first). From md the
 *             items float into two columns (596 / 680): odd/even items left
 *             and right, each column packed independently so the gap between
 *             cards stays 24 whatever the posters' heights (a float sits
 *             directly under the previous float on its side). The right
 *             column starts with the announcement card, or 300px down
 *             without one. Items are capped at 600 wide and keep their
 *             column's edge. A large decorative illustration follows the
 *             list in normal flow (its own row, left of centre) so it can
 *             never overlap a card. Below md: one column, one item per row,
 *             no illustration.
 *   featured  One list: two columns from md, three from lg with the middle
 *             card pushed down 65px. Cards centre in a wider column.
 * ------------------------------------------------------------------------- */

.upcoming-events {
    --upcoming-events--padding-block: spaceFluid(48, 64);
    --upcoming-events--gap: spaceFluid(24, 32);
    --upcoming-events--column-gap: spaceFluid(20, 40);
    --upcoming-events--row-gap: space(24);
    --upcoming-events--offset: space(300);
    --upcoming-events--featured-offset: space(65);
    --upcoming-events--item-max-width: space(600);
    --upcoming-events--illustration-size: space(504);
    --upcoming-events--illustration-gap: spaceFluid(40, 64);
    --upcoming-events--illustration-inset: 10%;

    padding-block: var(--upcoming-events--padding-block);
    padding-inline: var(--container-padding);
}

.upcoming-events__inner {
    display: grid;
    gap: var(--upcoming-events--gap);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
}

.upcoming-events--labelled .upcoming-events__inner {
    @media (width >= theme('screens.md')) {
        grid-template-columns: auto minmax(0, 1fr);
    }
}

.upcoming-events__label {
    @apply type-h2;
    @apply vertical-label;

    margin: 0;
}

.upcoming-events__body {
    min-width: 0;
}

.upcoming-events__list {
    display: grid;
    gap: var(--upcoming-events--row-gap) var(--upcoming-events--column-gap);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
}

.upcoming-events__item {
    width: 100%;
    min-width: 0;
    max-width: var(--upcoming-events--item-max-width);
}

/* ---- Grid ---------------------------------------------------------------- */

.upcoming-events--grid {
    @media (width >= theme('screens.md')) {
        --upcoming-events--left: min(calc((100% - var(--upcoming-events--column-gap)) * 596 / 1276), var(--upcoming-events--item-max-width));
        --upcoming-events--right: min(calc((100% - var(--upcoming-events--column-gap)) * 680 / 1276), var(--upcoming-events--item-max-width));

        .upcoming-events__list {
            display: flow-root;
            gap: 0;
        }

        .upcoming-events__item {
            float: left;
            width: var(--upcoming-events--left);
            margin-bottom: var(--upcoming-events--row-gap);

            &:last-child {
                margin-bottom: 0;
            }
        }

        /* Without an announcement the even items go right, 300px down */
        &:not(.upcoming-events--announced) .upcoming-events__item:nth-child(even) {
            float: right;
            width: var(--upcoming-events--right);
        }

        &:not(.upcoming-events--announced) .upcoming-events__item:nth-child(2) {
            margin-top: var(--upcoming-events--offset);
        }

        /* With one, the announcement and the even events go right */
        &.upcoming-events--announced .upcoming-events__item:nth-child(odd) {
            float: right;
            width: var(--upcoming-events--right);
        }
    }
}

.upcoming-events__illustration {
    display: none;
    color: var(--color-foreground);
    pointer-events: none;

    @media (width >= theme('screens.md')) {
        --illustration--size: var(--upcoming-events--illustration-size);

        display: block;
        clear: both;
        width: min(var(--upcoming-events--illustration-size), 38%);
        margin-top: var(--upcoming-events--illustration-gap);
        margin-left: var(--upcoming-events--illustration-inset);
    }
}

/* ---- Featured ------------------------------------------------------------ */

.upcoming-events--featured {
    .upcoming-events__list {
        @media (width >= theme('screens.md')) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @media (width >= theme('screens.lg')) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .upcoming-events__item {
        margin-inline: auto;
    }

    .upcoming-events__item:nth-child(2) {
        @media (width >= theme('screens.lg')) {
            margin-top: var(--upcoming-events--featured-offset);
        }
    }
}

/* ---- Empty state --------------------------------------------------------- */

.upcoming-events__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-base);
}

.upcoming-events__empty-text {
    @apply type-large;

    margin: 0;
}

.upcoming-events__empty-link {
    @apply type-h6;
}
