/* ---------------------------------------------------------------------------
 * Upcoming Events (block)
 *
 * Full-width band with the page gutter as side padding: the vertical label
 * (left gutter, rotated from md) and one list of Event Cards.
 *
 *   grid      From md, two columns (596 / 680). Each card spans two rows,
 *             offset by one from the card before it, so the columns stagger
 *             without JavaScript: left cards occupy rows 1–2, 3–4…, right
 *             cards rows 2–3, 4–5…. Row 1 of the right column holds the
 *             announcement card, or is a fixed 300px offset without one.
 *             A large decorative illustration sits bottom-left after the
 *             last card.
 *   featured  Two columns from md, three from lg with the middle card
 *             pushed down 65px.
 *
 * Below md: one column in date order, no stagger, no illustration.
 * ------------------------------------------------------------------------- */

.upcoming-events {
    --upcoming-events--padding-block: spaceFluid(48, 64);
    --upcoming-events--gap: spaceFluid(24, 32);
    --upcoming-events--column-gap: spaceFluid(20, 40);
    --upcoming-events--row-gap: space(24);
    --upcoming-events--offset: space(300);
    --upcoming-events--featured-offset: space(65);
    --upcoming-events--illustration-size: space(504);
    --upcoming-events--illustration-overlap: space(244);

    padding-block: var(--upcoming-events--padding-block);
    padding-inline: var(--container-padding);
}

.upcoming-events__inner {
    display: grid;
    gap: var(--upcoming-events--gap);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
}

.upcoming-events--labelled .upcoming-events__inner {
    @media (width >= theme('screens.md')) {
        grid-template-columns: auto minmax(0, 1fr);
    }
}

.upcoming-events__label {
    @apply type-h2;
    @apply vertical-label;

    margin: 0;
}

.upcoming-events__body {
    position: relative;
    min-width: 0;
}

.upcoming-events__list {
    display: grid;
    gap: var(--upcoming-events--row-gap) var(--upcoming-events--column-gap);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
}

.upcoming-events__item {
    min-width: 0;
}

/* ---- Grid ---------------------------------------------------------------- */

.upcoming-events--grid {
    .upcoming-events__list {
        @media (width >= theme('screens.md')) {
            grid-template-columns: 596fr 680fr;
        }
    }

    .upcoming-events__item {
        @media (width >= theme('screens.md')) {
            grid-column: var(--upcoming-events--column, auto);
            grid-row: var(--upcoming-events--row, auto) / span 2;
        }
    }

    .upcoming-events__item--announcement {
        @media (width >= theme('screens.md')) {
            grid-column: 2;
            grid-row: 1;
        }
    }

    /* No announcement: the right column starts 300px down */
    &:not(.upcoming-events--announced) .upcoming-events__list {
        @media (width >= theme('screens.md')) {
            grid-template-rows: var(--upcoming-events--offset);
        }
    }
}

.upcoming-events--illustrated .upcoming-events__body {
    @media (width >= theme('screens.md')) {
        padding-bottom: var(--upcoming-events--illustration-overlap);
    }
}

.upcoming-events__illustration {
    display: none;
    color: var(--color-foreground);
    pointer-events: none;

    @media (width >= theme('screens.md')) {
        --illustration--size: var(--upcoming-events--illustration-size);

        display: block;
        position: absolute;
        left: 10%;
        bottom: 0;
        width: min(var(--upcoming-events--illustration-size), 38%);
    }
}

/* ---- Featured ------------------------------------------------------------ */

.upcoming-events--featured {
    .upcoming-events__list {
        @media (width >= theme('screens.md')) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @media (width >= theme('screens.lg')) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .upcoming-events__item:nth-child(2) {
        @media (width >= theme('screens.lg')) {
            margin-top: var(--upcoming-events--featured-offset);
        }
    }
}

/* ---- Empty state --------------------------------------------------------- */

.upcoming-events__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-base);
}

.upcoming-events__empty-text {
    @apply type-large;

    margin: 0;
}

.upcoming-events__empty-link {
    @apply type-h6;
}
