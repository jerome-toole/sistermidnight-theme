/* ---------------------------------------------------------------------------
 * Event header (partial)
 *
 * Event single top on the page colour, 48–78 padding above and below: the
 * poster (496 wide, natural ratio, 3px stone-beige border) then the text (590 wide), 125
 * apart, in the design's 1211 frame at x154 (1440): from md the frame sits
 * 39.5px right of centre and stays inside the gutter on narrower screens.
 * Text: eyebrow / title / meta (gap 16, 15) then, 52 below, the excerpt and
 * the CTA (gap 32). Below md the poster comes first at full width.
 * ------------------------------------------------------------------------- */

.event-header {
    --event-header--padding-block: spaceFluid(48, 78);
    --event-header--content-width: space(590);
    --event-header--poster-width: space(496);
    --event-header--poster-border: 3px;
    --event-header--gap: spaceFluid(32, 52);
    --event-header--frame: space(1211);
    --event-header--frame-shift: space(39.5);
    --event-header--column-gap: spaceFluid(32, 125);

    padding-block: var(--event-header--padding-block);
    padding-inline: var(--container-padding);
}

.event-header__inner {
    align-items: start;

    @media (width >= theme('screens.md')) {
        max-width: var(--event-header--frame);
        margin-inline: clamp(0px, (100% - var(--event-header--frame)) / 2 + var(--event-header--frame-shift), 100% - var(--event-header--frame)) 0;
        column-gap: var(--event-header--column-gap);
        grid-template-columns: minmax(0, 496fr) minmax(0, 590fr);
    }
}

.event-header__poster {
    display: flex;
    justify-content: flex-start;
}

.event-header__image {
    display: block;
    width: 100%;
    max-width: var(--event-header--poster-width);
    height: auto; /* natural ratio: posters are never cropped */
    border: var(--event-header--poster-border) solid var(--color-stone-beige);
    background-color: var(--color-stone-beige);
}

.event-header__content {
    display: flex;
    flex-direction: column;
    gap: var(--event-header--gap);
    max-width: var(--event-header--content-width);
}

.event-header__intro {
    display: flex;
    flex-direction: column;
    gap: space(16);
}

.event-header__presenter {
    @apply type-h6;

    margin: 0;
    line-height: 1.2;
}

.event-header__title {
    @apply type-h1;

    margin: 0;
    overflow-wrap: break-word;
    hyphens: auto;
}

.event-header__meta {
    @apply type-h6;

    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: space(8) space(24);
    margin: 0;
    line-height: 1.2;

    dd {
        margin: 0;
    }
}

.event-header__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: space(32);
}

.event-header__excerpt {
    @apply type-body;

    margin: 0;
}

.event-header__note {
    @apply type-h6;

    margin: 0;
    line-height: 1.2;
}
