{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "theme/values-list",
    "title": "Values List",
    "description": "Display numbered values or principles",
    "category": "theme-blocks",
    "icon": "editor-ol",
    "keywords": [
        "values",
        "principles",
        "manifesto",
        "numbered",
        "list"
    ],
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "postTypes": [
            "page",
            "gust-template"
        ],
        "renderCallback": "Gust\\Components\\ValuesList::renderBlock"
    },
    "supports": {
        "anchor": true,
        "align": [
            "wide",
            "full"
        ],
        "color": {
            "background": true,
            "text": false,
            "gradients": false
        }
    }
}
