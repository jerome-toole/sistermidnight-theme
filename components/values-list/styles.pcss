:where(.values-list) {
    --animate--item--delay: 100ms;
    --animate--duration: 500ms;
    --animate--animation: animate--fade-in--translate;
    --animate--translateY: 20px;

    padding-block: space(32);
}

:where(.values-list__heading) {
    margin-block-end: space(24);
}

:where(.values-list__intro) {
    @apply margin-trim;

    max-width: 65ch;
    margin-block-end: space(48);
    font-size: var(--text-base);
    line-height: 1.6;
}

:where(.values-list__items) {
    --cols: 1;
    --col-gap: space(32);
    --row-gap: space(48);

    @apply flex-grid;

    list-style: none;
    padding: 0;
    margin: 0;

    @media (min-width: theme('screens.md')) {
        --cols: 2;
    }
}

:where(.values-list__item) {
    display: flex;
    gap: space(24);
}

:where(.values-list__number) {
    flex-shrink: 0;
    font-family: var(--font-display), ui-serif, serif;
    font-size: var(--text-hero);
    line-height: 0.85;
    opacity: 0.2;
}

:where(.values-list__content) {
    @apply margin-trim;

    display: flex;
    flex-direction: column;
    gap: space(12);
}

:where(.values-list__title) {
    font-family: var(--font-display), ui-serif, serif;
    font-size: var(--text-h3);
    font-weight: 400;
    margin: 0;
}

:where(.values-list__description) {
    @apply margin-trim;

    font-size: var(--text-base);
    line-height: 1.6;
}
