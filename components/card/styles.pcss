/* ---------------------------------------------------------------------------
 * Card (block)
 *
 * Paper card on stone-beige: heading, rich text, optional "Read more" link,
 * optional Newsletter Form, and an optional small illustration pinned to the
 * top-right corner. `lg` pads 24 with a 108px illustration, `sm` pads 20
 * with an 86px one. Width comes from the parent (scatter grid, Upcoming
 * grid); full width on its own.
 * ------------------------------------------------------------------------- */

.card {
    --card--padding: space(24);
    --card--gap: space(26);
    --card--illustration-size: space(108);
    --card--illustration-offset: space(6);

    @apply color-context-stone-beige;

    position: relative;
    width: 100%;
    padding: var(--card--padding);
    transition: transition(background-color);

    /* Lighten the paper while the "Read more" link is hovered or focused */
    &:has(.card__link:hover, .card__link:focus-visible) {
        background-color: var(--card--background-hover);
    }
}

.card--sm {
    --card--padding: space(20);
    --card--illustration-size: space(86);
}

.card__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--card--gap);
}

.card__heading {
    @apply type-title-sm;

    margin: 0;
}

/* Keep the heading clear of the illustration */
.card--illustrated .card__heading {
    padding-right: calc(var(--card--illustration-size) + var(--card--illustration-offset));
}

.card__text {
    @apply type-body;
    @apply margin-trim;

    max-width: space(560);

    > * + * {
        margin-top: var(--space-base);
    }
}

.card__placeholder {
    opacity: 0.6;
}

/* The design's "Read more" is in the text colour, not the context link colour */
.card__link {
    --link--color: var(--color-foreground);
    --link--color-hover: var(--color-foreground);

    @apply type-body;
}

.card__form {
    width: 100%;
}

.card__illustration {
    position: absolute;
    top: var(--card--illustration-offset);
    right: var(--card--illustration-offset);
    width: var(--card--illustration-size);
    color: var(--color-foreground);
    pointer-events: none;
}
