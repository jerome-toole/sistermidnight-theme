{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "theme/image-pair",
    "title": "Image Pair",
    "description": "Two portrait images side by side on a padded section.",
    "category": "theme-blocks",
    "icon": "images-alt2",
    "keywords": ["image", "images", "pair", "photos"],
    "textdomain": "gust",
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "renderCallback": "Gust\\Components\\ImagePair::renderBlock"
    },
    "supports": {
        "anchor": true,
        "align": false,
        "mode": false,
        "jsx": false,
        "html": false,
        "color": {
            "background": false,
            "text": false,
            "gradients": false
        }
    }
}
