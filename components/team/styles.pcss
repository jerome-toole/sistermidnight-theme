/* ---------------------------------------------------------------------------
 * Team (block)
 *
 * Stone-beige section, padded 71 top with the portraits running to the
 * bottom edge (as in the design); the page gutter as side padding with the
 * vertical label (rotated from md) in it. The portraits are a native
 * horizontal scroller with snap points, 260×340, gap 16, bleeding to the
 * right edge of the viewport.
 *
 * Each caption is placed on its portrait by the member's custom properties
 * (--team--name-x / -y in percent, --team--name-rotation in degrees, set
 * inline from the CMS) and turned around its top-left corner. The caption
 * is a button; its panel (burnt-sienna, cool-grey text, 262 wide) opens on
 * hover, focus-within or when the button is expanded (scripts.js); on touch
 * (hover: none) a tap anywhere on the portrait toggles it. On hover
 * with a pointer scripts.js fixes the panel next to the cursor
 * (.team__panel--cursor); when focused or pinned open it sits anchored to
 * the bottom of the portrait instead.
 * ------------------------------------------------------------------------- */

.team {
    --team--padding-top: spaceFluid(48, 71);
    --team--gap: spaceFluid(24, 32);
    --team--member-width: space(260);
    --team--member-ratio: 260 / 340;
    --team--track-gap: space(16);
    --team--caption-padding: space(8);
    --team--panel-inset: space(12);
    --team--panel-width: space(262);
    --team--panel-padding: space(10) space(6) space(8);

    padding-block: var(--team--padding-top) 0;
    padding-inline: var(--container-padding);
}

.team__inner {
    display: grid;
    gap: var(--team--gap);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
}

.team--labelled .team__inner {
    @media (width >= theme('screens.md')) {
        grid-template-columns: auto minmax(0, 1fr);
    }
}

.team__label {
    @apply type-h2;
    @apply vertical-label;

    margin: 0;
}

.team__body {
    min-width: 0;
}

.team__placeholder {
    opacity: 0.6;
}

/* ---- Track ---------------------------------------------------------------- */

.team__track {
    display: flex;
    gap: var(--team--track-gap);
    margin: 0;

    /*
     * Captions rotated up past the top of a portrait would be cut off by the
     * scroller (overflow-x forces overflow-y to clip). Pad the top by the
     * section's top padding and pull it back with a negative margin, so the
     * portraits stay where the design puts them and the names can spill
     * into the section padding.
     */
    margin-block-start: calc(-1 * var(--team--padding-top));

    /* Runs to the right edge of the viewport */
    margin-inline-end: calc(-1 * var(--container-padding));
    padding: 0;
    padding-block-start: var(--team--padding-top);
    padding-inline-end: var(--container-padding);
    scroll-padding-inline-end: var(--container-padding);
    list-style: none;
    overflow-x: auto;
    overflow-y: clip;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }

    @media (prefers-reduced-motion: reduce) {
        scroll-behavior: auto;
    }
}

.team__member {
    position: relative;
    flex: none;
    width: var(--team--member-width);
    aspect-ratio: var(--team--member-ratio);
    margin: 0;
    scroll-snap-align: start;
}

.team__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;

    /* The portraits are cut-outs on white: multiply drops the white into the stone-beige */
    mix-blend-mode: multiply;
}

.team__img--empty {
    background: var(--color-dark-umber);
    opacity: 0.15;
}

/* ---- Caption and panel --------------------------------------------------- */

.team__caption {
    position: absolute;
    top: var(--team--name-y, 8%);
    left: var(--team--name-x, 8%);
    width: max-content;
    rotate: var(--team--name-rotation, 0deg);
    transform-origin: 0 0;
}

.team__toggle {
    @apply type-body;

    --focus--color: var(--color-dark-umber);

    display: block;
    margin: calc(-1 * var(--team--caption-padding));
    padding: var(--team--caption-padding);
    border: 0;
    background: transparent;
    color: var(--color-dark-umber);
    font: inherit;
    font-weight: 700;
    text-align: inherit;
    white-space: nowrap;
    cursor: pointer;

    &:focus {
        @apply focus-base;
    }
}

.team__toggle--static {
    cursor: default;
}

.team__panel {
    @apply color-context-burnt-sienna;

    position: absolute;
    z-index: 1;
    display: none;
    inset-inline: var(--team--panel-inset);
    inset-block-end: var(--team--panel-inset);
    width: min(var(--team--panel-width), calc(100% - 2 * var(--team--panel-inset)));
    padding: var(--team--panel-padding);
    color: var(--color-cool-grey);

    /* Open: hover or keyboard focus (no JS needed), or expanded by scripts.js */
    .team__member:hover &,
    .team__member:focus-within &,
    .team__member:has(.team__toggle[aria-expanded='true']) & {
        display: block;
    }

    @media (hover: none) {
        /*
         * Touch: a tap on the portrait or name toggles the panel (scripts.js).
         * Neither sticky hover nor the focus a tap leaves behind keeps it
         * open, so a second tap closes it; keyboard focus still opens it.
         */
        .team__member:hover &,
        .team__member:focus-within & {
            display: none;
        }

        .team__member:has(.team__toggle:focus-visible) &,
        .team__member:has(.team__toggle[aria-expanded='true']) & {
            display: block;
        }
    }

    /* Escape closed it while the toggle still has focus (scripts.js) */
    .team__member[data-dismissed] & {
        display: none;
    }

    /* Following the pointer (scripts.js sets --team--panel-x/-y in viewport px) */
    &.team__panel--cursor {
        position: fixed;
        z-index: calc(var(--z-index-paper) - 1);
        inset: auto;
        top: var(--team--panel-y, 0);
        left: var(--team--panel-x, 0);
        width: min(var(--team--panel-width), calc(100vw - 2 * var(--container-padding)));
        pointer-events: none;
    }
}

.team__name,
.team__bio {
    margin: 0;
}

.team__name {
    @apply type-body;

    font-weight: 700;
}

.team__bio {
    @apply type-small;

    margin-block-start: space(14);
}
