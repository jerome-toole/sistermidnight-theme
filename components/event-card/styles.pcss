/* ---------------------------------------------------------------------------
 * Event Card (partial)
 *
 * Paper card on stone-beige, padding 24, 32 between poster and text. The
 * whole card is one link. Header (presenter, title, excerpt) gap 12; the
 * meta row sits at the bottom, at least 65–77 below the header.
 * `lg` caps the poster at 410 wide (front page); `sm` fills the card
 * (What's On featured). Both cap the card at 600 wide, left-aligned in a
 * wider column. Mobile: full width, poster max-height 70vw.
 * Hover / focus-visible on the link lightens the whole card slightly (the
 * display-font title is never underlined).
 * ------------------------------------------------------------------------- */

.event-card {
    --event-card--padding: space(24);
    --event-card--max-width: space(600);
    --event-card--poster-width: space(410);
    --event-card--meta-gap: spaceFluid(40, 77);

    @apply color-context-stone-beige;

    position: relative;
    width: 100%;
    max-width: var(--event-card--max-width);
    transition: background-color 150ms ease;

    &:has(.event-card__link:hover),
    &:has(.event-card__link:focus-visible) {
        background-color: color-mix(in srgb, var(--color-background) 92%, white);
    }

    /* Inset ring: the context's focus colour is for the paper, not the page around it */
    &:has(.event-card__link:focus-visible) {
        outline: var(--base--focus-width, 2px) solid var(--focus--color);
        outline-offset: calc(var(--event-card--padding) / -2);
    }
}

.event-card--sm {
    --event-card--poster-width: 100%;
    --event-card--meta-gap: spaceFluid(40, 65);

    /* Design: Sister 38–47 (~3 lines at 405 wide) */
    .event-card__title {
        font-size: spaceFluid(32, 38);
        line-height: 1;
    }

    /* One row like the design ("23rd March … Catford House"): the time lives on the event page */
    .event-card__time {
        display: none;
    }
}

.event-card__link {
    display: flex;
    flex-direction: column;
    gap: space(32);
    height: 100%;
    padding: var(--event-card--padding);
    color: inherit;
    text-decoration: none;

    &:focus-visible {
        outline: none;
    }
}

.event-card__poster {
    width: 100%;
    max-width: var(--event-card--poster-width);
}

/* Natural ratio, never cropped: below md a tall poster shrinks to 70vw high */
.event-card__image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 70vw;

    @media (width >= theme('screens.md')) {
        width: 100%;
        max-height: none;
    }
}

.event-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--event-card--meta-gap);
}

.event-card__header {
    display: flex;
    flex-direction: column;
    gap: space(12);
}

.event-card__presenter {
    @apply type-h6;

    margin: 0;
    line-height: 1.2;
}

.event-card__title {
    @apply type-h2;

    margin: 0;
    overflow-wrap: break-word;
    hyphens: auto;
    text-decoration: none;
}

.event-card__excerpt {
    @apply type-body;

    margin: 0;
}

.event-card__meta {
    @apply type-h6;

    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: space(4) space(17);
    line-height: 1.2;
    margin: 0;
    margin-top: auto;
}

/* Date and time stay together; the venue sits opposite and only drops under on very narrow cards */
.event-card__when {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 space(8);
}

.event-card__date,
.event-card__time,
.event-card__venue {
    white-space: nowrap;
}

.event-card__venue {
    margin-left: auto;
}
