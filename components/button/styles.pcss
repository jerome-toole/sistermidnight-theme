/* --------------------------------------------------- */
/* Button
 *
 * `.button` alone is an unstyled control (used by toggles). Variants:
 *   .button--primary  burnt-sienna fill, 200×58, label left + arrow right
 *   .button--link     underlined text + arrow, follows the link colour
 *
 * The arrow is the shared ↗ Icon (`.button__icon`, 16×15 viewBox) so it takes
 * `currentColor`; it nudges up-right on hover.
 */
/* --------------------------------------------------- */

.button {
    --button--gap: space(12);
    --button--icon-size: space(16);

    @apply button-reset;

    &:focus {
        @apply focus-base;
    }

    .button__icon {
        flex: 0 0 auto;
        width: var(--button--icon-size);
        height: var(--button--icon-size);
        aspect-ratio: 16 / 15;
        height: auto;
        transform: translate(0, 0);
        transition: transition(transform);
    }

    @media (hover: hover) {
        &:hover .button__icon {
            transform: translate(10%, -10%);
        }
    }
    @media (hover: none) {
        &:active .button__icon {
            transform: translate(10%, -10%);
        }
    }
}

/* The variant box styles are utilities so the core Buttons block (Primary and
 * Link block styles in core-blocks) shares them instead of duplicating rules. */

/* button-primary: burnt-sienna fill. The colour context sets the label and
 * focus colours, so the button reads the same on any section background.
 *
 * The focus ring is drawn inset, against the button's own fill (warm-sand on
 * burnt-sienna, 3.5:1): the context's warm-sand ring would otherwise sit
 * outside the button on whatever the section colour is, and on stone-beige
 * it all but disappears (~1.1:1). */
@utility button-primary {
    --base--focus-offset: -4px;

    @apply color-context-burnt-sienna;
    @apply type-base;

    /* Warm-sand on burnt-sienna is 3.5:1, which WCAG allows only for large text
     * (bold >= 19px). type-base bottoms out at 18px, so the label never fluids
     * below 19px. */
    font-size: max(19px, var(--text-base));

    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--button--gap, space(12));
    min-width: space(200);
    min-height: space(58);
    padding: space(10) space(20);
    border-radius: 0;
    text-align: left;
    text-decoration: none;
    transition: transition(background-color, color);

    @media (hover: hover) {
        &:hover {
            background-color: color-mix(in oklab, var(--color-burnt-sienna) 85%, var(--color-dark-umber));
            color: var(--color-foreground);
            text-decoration: none;
        }
    }
    @media (hover: none) {
        &:active {
            background-color: color-mix(in oklab, var(--color-burnt-sienna) 85%, var(--color-dark-umber));
            color: var(--color-foreground);
            text-decoration: none;
        }
    }

    &:disabled,
    &[aria-disabled="true"] {
        cursor: not-allowed;
        opacity: 0.5;
    }
}

.button--primary {
    @apply button-primary;
}

/* button-link: underlined label + arrow, in the current link colour */
@utility button-link {
    --button--icon-size: 0.9em;
    --link--text-decoration: underline;
    --link--text-decoration--hover: underline;

    @apply link;
    @apply type-base;

    display: inline-flex;
    align-items: center;
    gap: space(6);
    min-height: space(24); /* WCAG 2.5.8 target size */
    padding: 0;
    background: transparent;
    text-underline-offset: 0.15em;
}

.button--link {
    @apply button-link;

    .button__icon {
        stroke-width: 2.5;
    }
}
