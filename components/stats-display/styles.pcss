:where(.stats-display) {
    --animate--duration: 500ms;
    --animate--animation: animate--fade-in--translate;
    --animate--translateY: 20px;
    --ring-size: clamp(180px, 40vw, 400px);
    --ring-stroke: 8px;
    --ring-color: var(--color-orange, #e65c00);
    --ring-bg-color: color-mix(in srgb, var(--ring-color) 20%, transparent);
    --ring-circumference: 565.48; /* 2 * PI * 90 */

    display: flex;
    justify-content: center;
}

:where(.stats-display__circle) {
    position: relative;
    width: var(--ring-size);
    height: var(--ring-size);
    display: flex;
    align-items: center;
    justify-content: center;
}

:where(.stats-display__ring) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
}

:where(.stats-display__ring-bg) {
    fill: none;
    stroke: var(--ring-bg-color);
    stroke-width: var(--ring-stroke);
}

:where(.stats-display__ring-progress) {
    fill: none;
    stroke: var(--ring-color);
    stroke-width: var(--ring-stroke);
    stroke-linecap: round;
    stroke-dasharray: var(--ring-circumference);
    stroke-dashoffset: var(--ring-circumference);
    transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
}

:where(.stats-display.animate--play .stats-display__ring-progress) {
    stroke-dashoffset: calc(var(--ring-circumference) * (1 - var(--ring-percent, 85) / 100));
}

:where(.stats-display__content) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: space(4);
}

:where(.stats-display__value) {
    font-family: var(--font-display), ui-serif, serif;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
}

:where(.stats-display__label) {
    font-size: var(--type-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
}
