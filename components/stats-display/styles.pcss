:where(.stats-display) {
    --animate--item--delay: 100ms;
    --animate--duration: 500ms;
    --animate--animation: animate--fade-in--translate;
    --animate--translateY: 20px;

    padding-block: var(--space-lg);
}

:where(.stats-display__grid) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg) var(--space-xl);
}

:where(.stats-display__item) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
}

:where(.stats-display__value) {
    font-family: var(--font-display), ui-serif, serif;
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
}

:where(.stats-display__label) {
    font-size: var(--type-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
}

:where(.stats-display--compact) {
    padding-block: var(--space-md);

    & .stats-display__grid {
        gap: var(--space-md) var(--space-lg);
    }

    & .stats-display__value {
        font-size: clamp(2rem, 5vw, 3rem);
    }

    & .stats-display__label {
        font-size: var(--type-meta);
    }
}
