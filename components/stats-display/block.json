{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "theme/stats-display",
    "title": "Stats Display",
    "category": "theme-blocks",
    "icon": "chart-bar",
    "keywords": [
        "stats",
        "numbers",
        "fundraising",
        "counter"
    ],
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "postTypes": [
            "page",
            "gust-template"
        ],
        "renderCallback": "Gust\\Components\\StatsDisplay::renderBlock"
    },
    "supports": {
        "anchor": true,
        "align": [
            "wide",
            "full"
        ],
        "color": {
            "background": true,
            "text": false,
            "gradients": false
        }
    }
}
