.homepage-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: space(90);
    text-align: center;
    overflow: hidden;
    color: var(--color-black);

    @media (min-width: theme('screens.md')) {
        padding-top: space(32);
        padding-bottom: var(--space--layout);
    }

    + * {
        margin-top: 0;
    }
}

:where(.homepage-hero__graphic) {
    display: none;

    @media (min-width: theme('screens.md')) {
        display: block;
        position: relative;
        width: 100%;
        max-width: 1900px;
        margin-inline: auto;
        padding-inline: space(24) space(8);
        container-type: inline-size;
    }

    & svg {
        width: 100%;
        height: auto;
        display: block;
    }
}

:where(.homepage-hero__text) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 22cqi;
}

:where(.homepage-hero__mobile-text) {
    padding-inline: var(--space--container-padding);

    @media (min-width: theme('screens.md')) {
        display: none;
    }
}

:where(.homepage-hero__line-1) {
    margin: 0;
    font-family: var(--font-sistermidnight);
    font-size: var(--type-lg);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-wrap: balance;

    .homepage-hero__text & {
        font-size: 2.4cqi;
    }
}

:where(.homepage-hero__line-2) {
    margin: 0.5em 0 0;
    font-family: var(--font-sistermidnight);
    font-size: var(--type-sm);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.02em;

    .homepage-hero__text & {
        font-size: 1.75cqi;
    }
}

:where(.homepage-hero__line-3) {
    margin: 0.3em 0 0;
    font-family: var(--font-sistermidnight);
    font-size: var(--type-lg);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;

    .homepage-hero__text & {
        font-size: 2.4cqi;
    }
}

:where(.homepage-hero__cta) {
    --btn--background-color: var(--color-orange);
    --btn--border-color: var(--color-orange);
    --btn--color: var(--color-white);
    --btn--background-color--hover: var(--color-burnt-orange);
    --btn--border-color--hover: var(--color-burnt-orange);
    --btn--color-hover: var(--color-white);

    position: fixed;
    bottom: var(--space-md);
    right: var(--space-md);
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);

    @media (hover: hover) {
        &:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
        }
    }

    @media (min-width: theme('screens.md')) {
        bottom: var(--space-lg);
        right: var(--space-lg);
    }
}
