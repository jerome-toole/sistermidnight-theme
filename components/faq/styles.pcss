/* ---------------------------------------------------------------------------
 * FAQ (block)
 *
 * Heading (type-h3) then questions as native <details>. Question row is
 * type-h6 uppercase with 8px vertical padding and a chevron; answer is
 * type-body rich text. Gaps from the design: 40 between heading and items
 * and between items, 12 between question and answer.
 * ------------------------------------------------------------------------- */

.faq {
    --faq--gap: space(40);
    --faq--answer-gap: space(12);
    --faq--chevron-size: space(14);

    display: flex;
    flex-direction: column;
    gap: var(--faq--gap);
}

.faq__heading {
    @apply type-h3;

    margin: 0;
}

.faq__items {
    display: flex;
    flex-direction: column;
    gap: var(--faq--gap);
}

.faq__question {
    @apply type-h6;

    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: space(8);
    cursor: pointer;
    gap: space(12);
    list-style: none;
    line-height: 1.2; /* type-h6 is set solid for one-line eyebrows; questions wrap */
    text-transform: uppercase;

    &::-webkit-details-marker {
        display: none;
    }

    &::after {
        flex: none;
        width: var(--faq--chevron-size);
        height: var(--faq--chevron-size);
        background-color: currentColor;
        content: '';
        mask: url('/images/icons/chevron-down.svg') center / contain no-repeat;
    }

    [open] > &::after {
        transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: no-preference) {
        &::after {
            transition: transition(transform);
        }
    }
}

.faq__answer {
    @apply type-body;
    @apply margin-trim;

    padding-top: var(--faq--answer-gap);

    > * + * {
        margin-top: var(--space-base);
    }
}

.faq__placeholder {
    opacity: 0.6;
}
