:where(.team-grid) {
    --animate--item--delay: 100ms;
    --animate--duration: 500ms;
    --animate--animation: animate--fade-in--translate;
    --animate--translateY: 20px;

    padding-block: var(--space-lg);
}

:where(.team-grid__heading) {
    margin-block-end: var(--space-lg);
}

:where(.team-grid__grid) {
    --grid--columns: 1;

    @apply flex-grid;

    gap: var(--space-xl) var(--space-lg);

    @media (min-width: theme('screens.md')) {
        --grid--columns: 2;
    }

    @media (min-width: theme('screens.lg')) {
        --grid--columns: 3;
    }
}

:where(.team-grid__item) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}

:where(.team-grid__image) {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-warm-grey);

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

:where(.team-grid__image--placeholder) {
    min-height: 200px;
}

:where(.team-grid__content) {
    @apply margin-trim;
}

:where(.team-grid__name) {
    font-family: var(--font-display), ui-serif, serif;
    font-size: var(--type-lg);
    font-weight: 400;
    margin: 0;
}

:where(.team-grid__role) {
    font-size: var(--type-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin: 0;
    margin-block-start: var(--space-3xs);
}

:where(.team-grid__bio) {
    @apply margin-trim;

    font-size: var(--type-base);
    line-height: 1.6;
    margin-block-start: var(--space-xs);
}
