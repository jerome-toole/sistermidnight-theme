/* Event Details inline popovers (editor window, outside the canvas iframe).
 * The field group sets half/quarter widths for the expanded editor; in the
 * narrow inline popover every field takes the full width instead. */

.acf-inline-fields-popover-inner .acf-field[data-key^='field_event_'] {
    width: 100% !important;
    min-height: 0 !important;
    border-inline-start: 0 !important;
}
