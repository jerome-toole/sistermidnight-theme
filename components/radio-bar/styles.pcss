/* ---------------------------------------------------------------------------
 * Radio bar
 *
 * 64px band on burnt-sienna. From md up: brand left, Listen right, and the
 * now-playing line centred in the space between them (as in the design).
 * Below md: two rows, brand + Listen on the first, track centred on the
 * second with overflow ellipsis.
 *
 *   .radio-bar__brand     marque (28px) + logotype (19px tall, shrinks on narrow screens), inline SVGs
 *   .radio-bar__track     "Now playing: …", or "Off air"
 *   .radio-bar__listen    external link to the SMFM site, type-h5 (fixed 20px) + .link-external arrow
 *
 * Listen is pinned to 20px rather than the fluid 18–20px h5 token: warm-sand
 * on burnt-sienna is 3.47:1, which passes only as bold large text (>= 19px),
 * so the size must not drop below that at narrow widths.
 * ------------------------------------------------------------------------- */

.radio-bar {
    --radio-bar--padding: space(16);

    display: grid;
    grid-template-areas:
        'brand listen'
        'track track';
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: space(24);
    row-gap: space(8);
    align-items: center;
    padding: space(12) var(--radio-bar--padding);

    @media (width >= theme('screens.md')) {
        --radio-bar--padding: space(24);

        grid-template-areas: 'brand track listen';
        grid-template-columns: auto minmax(0, 1fr) auto;
        min-height: space(64);
        padding-block: 0;
    }
}

.radio-bar__brand {
    display: flex;
    grid-area: brand;
    align-items: center;
    gap: space(4);
    min-width: 0;
    margin: 0;
    color: var(--color-foreground);
    line-height: 0;
}

.radio-bar__marque {
    flex: 0 0 auto;
    width: space(28);
    height: space(28);
}

/* 240×19 in the design; `width: 100%` + max-width lets it shrink with the row. */
.radio-bar__wordmark {
    flex: 1 1 auto;
    width: 100%;
    max-width: space(218);
    min-width: 0;
    height: auto;
    aspect-ratio: 241 / 21;
}

.radio-bar__track {
    @apply type-base;

    grid-area: track;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.radio-bar__listen {
    @apply type-h5 link link--2 link--foreground;

    grid-area: listen;
    justify-self: end;
    min-height: space(24); /* WCAG 2.5.8 target size */
    font-size: rem(20);
    line-height: 1;
    text-transform: uppercase;

    &:focus {
        @apply focus-base;
    }
}
