/* ---------------------------------------------------------------------------
 * Radio bar
 *
 * 64px band on burnt-sienna. From md up: brand in the left 40%, the now-playing
 * line and Listen link share the right 60% (track grows, Listen stays at the
 * right edge). Below md: two rows, brand + Listen on the first, track on the
 * second with overflow ellipsis.
 *
 *   .radio-bar__brand   marque + wordmark (type-h5, type-h6 below md)
 *   .radio-bar__track   "Now playing: …", hidden while offline
 *   .radio-bar__listen  external link, type-h6 + arrow
 * ------------------------------------------------------------------------- */

.radio-bar {
    --radio-bar--padding: space(16);

    display: grid;
    grid-template-areas:
        'brand listen'
        'track track';
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: space(24);
    row-gap: space(8);
    align-items: center;
    padding: space(12) var(--radio-bar--padding);

    @media (width >= theme('screens.md')) {
        --radio-bar--padding: space(24);

        grid-template-areas: 'brand track listen';
        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) auto;
        min-height: space(64);
        padding-block: 0;
    }
}

.radio-bar__brand {
    @apply type-h6;

    display: flex;
    grid-area: brand;
    align-items: center;
    gap: space(6);
    min-width: 0;
    margin: 0;
    line-height: 1;
    text-transform: uppercase;

    @media (width >= theme('screens.md')) {
        @apply type-h5;
    }
}

.radio-bar__marque {
    flex: 0 0 auto;
    width: space(28);
    height: space(28);
}

.radio-bar__wordmark {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.radio-bar__track {
    @apply type-base;

    grid-area: track;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    &[hidden] {
        display: none;
    }
}

.radio-bar__listen {
    @apply type-h6 link link--2 link--foreground;

    display: inline-flex;
    grid-area: listen;
    align-items: center;
    gap: space(6);
    justify-self: end;
    line-height: 1;
    text-transform: uppercase;

    &:focus {
        @apply focus-base;
    }
}

.radio-bar__arrow {
    flex: 0 0 auto;
    width: space(14);
    height: space(14);
    transition: transition(transform);

    @media (hover: hover) {
        .radio-bar__listen:hover & {
            transform: translate(10%, -10%);
        }
    }
}
