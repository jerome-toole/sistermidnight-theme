:where(.document-links) {
    padding-block: var(--space-lg);
}

:where(.document-links__heading) {
    margin-block-end: var(--space-md);
}

:where(.document-links__list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
}

:where(.document-links__item) {
    border: 1px solid currentColor;
    border-radius: var(--radius-sm, 4px);
    opacity: 0.9;
    transition: opacity 150ms ease;
}

:where(.document-links__item:hover) {
    opacity: 1;
}

:where(.document-links__link) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    text-decoration: none;
    color: inherit;
}

:where(.document-links__icon) {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    opacity: 0.7;
}

:where(.document-links__icon svg) {
    width: 100%;
    height: 100%;
}

:where(.document-links__content) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
}

:where(.document-links__title) {
    font-weight: 500;
}

:where(.document-links__meta) {
    font-size: var(--type-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
}
