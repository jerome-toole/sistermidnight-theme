{
    "key": "group_component_document_links",
    "title": "Block - Document Links",
    "fields": [
        {
            "key": "field_document_links_heading",
            "label": "Heading",
            "name": "heading",
            "type": "text",
            "instructions": "Optional section heading",
            "required": 0,
            "default_value": "",
            "placeholder": "e.g. Downloads"
        },
        {
            "key": "field_document_links_documents",
            "label": "Documents",
            "name": "documents",
            "type": "repeater",
            "instructions": "Add downloadable documents",
            "required": 1,
            "collapsed": "field_document_links_title",
            "min": 1,
            "max": 0,
            "layout": "table",
            "button_label": "Add Document",
            "rows_per_page": 20,
            "sub_fields": [
                {
                    "key": "field_document_links_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "instructions": "Display title (uses filename if empty)",
                    "required": 0,
                    "placeholder": "e.g. Share Offer Document",
                    "parent_repeater": "field_document_links_documents"
                },
                {
                    "key": "field_document_links_file",
                    "label": "File",
                    "name": "file",
                    "type": "file",
                    "required": 1,
                    "return_format": "array",
                    "library": "all",
                    "mime_types": "pdf,doc,docx,xls,xlsx,zip",
                    "parent_repeater": "field_document_links_documents"
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "theme/document-links"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
