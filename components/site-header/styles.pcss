@import './styles/_menu.pcss';

@layer base {
    :root {
        --site-header--height: space(60);
        --site-header--top: var(--wp-admin-bar--height, 0px);
        --site-header--menu--duration: 250ms;
        --site-header--menu--ease: ease-in-out;

        @media (width >= theme('screens.site-header')) {
            --site-header--height: space(80);
        }
    }
}

.site-header {
    --site-header--spacing: space(16);

    position: fixed;
    top: var(--site-header--top);
    left: 0;
    right: 0;
    z-index: var(--z-index-site-header);
    background-color: var(--color-off-white);

    @media (width >= theme('screens.site-header')) {
        --site-header--spacing: space(32);
    }

    ~ .site-main {
        margin-top: var(--site-header--height);
    }
}

.site-header__bar {
    display: flex;
    width: 100%;
    height: var(--site-header--height);
    align-items: center;
    padding-inline: var(--space--container-padding);
    gap: var(--site-header--spacing);
    justify-content: space-between;

    @media (width >= theme('screens.site-header')) {
        @apply content-width-fluid-lg;
        padding-inline: 0;
    }
}

.site-header__logo {
    font-family: var(--font-sistermidnight);
    font-size: rem(18px);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-warm-black);
    text-decoration: none;

    @media (width >= theme('screens.site-header')) {
        font-size: rem(22px);
    }

    img {
        height: auto;
        max-height: space(32);

        @media (width >= theme('screens.site-header')) {
            max-height: space(40);
        }
    }

    &:hover,
    &:focus {
        color: var(--color-warm-black);
    }
}

.site-header__nav {
    display: none;

    @media (width >= theme('screens.site-header')) {
        display: flex;
        align-items: center;
        gap: var(--site-header--spacing);
    }
}

.site-header__radio-link {
    font-family: var(--font-rework);
    font-size: rem(14px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-warm-black);
    text-decoration: none;
    padding: space(8) space(16);
    border: 1px solid var(--color-warm-black);
    transition: background-color var(--transition--duration) var(--transition--ease),
        color var(--transition--duration) var(--transition--ease);

    &:hover,
    &:focus {
        background-color: var(--color-warm-black);
        color: var(--color-off-white);
    }

    .site-header__panel-content & {
        display: inline-block;
        margin-top: space(24);
    }
}

.site-header__burger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: space(8);
    margin-right: calc(space(8) * -1);
    background: transparent;
    border: 0;
    cursor: pointer;

    @media (width >= theme('screens.site-header')) {
        display: none;
    }
}

.site-header__panel {
    --panel--content-offset: 10px;
    --panel--content-opacity: 0;
    --panel--content-duration: calc(var(--site-header--menu--duration) + 100ms);

    position: fixed;
    top: calc(var(--site-header--top) + var(--site-header--height));
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    background-color: var(--color-off-white);
    clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
    opacity: 0;
    pointer-events: none;
    transition:
        clip-path var(--site-header--menu--duration) var(--site-header--menu--ease),
        opacity var(--site-header--menu--duration) var(--site-header--menu--ease);
    z-index: calc(var(--z-index-site-header) - 1);

    @media (width >= theme('screens.site-header')) {
        display: none;
    }

    &:not([inert]) {
        --panel--content-offset: 0;
        --panel--content-opacity: 1;

        clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
        opacity: 1;
        pointer-events: auto;
    }
}

.site-header__panel-content {
    display: flex;
    flex-direction: column;
    padding: space(32) var(--space--container-padding);
    overflow: auto;
    opacity: var(--panel--content-opacity);
    transform: translateY(var(--panel--content-offset));
    transition:
        opacity var(--panel--content-duration) var(--site-header--menu--ease),
        transform var(--panel--content-duration) var(--site-header--menu--ease);
}
