/* ---------------------------------------------------------------------------
 * Site header
 *
 * Wordmark left, primary nav right (type-h5, inline from md up). Below md the
 * nav lives in a full-screen native <dialog> (column list, type-h4) opened by
 * a "Menu" button; scripts.js wires the clicks where needed.
 *
 * Variants:
 *   .site-header--default  dark-umber context, in the page flow
 *   .site-header--hero     no background, absolutely positioned over the Hero
 *                          (it takes the Hero's colour context)
 * ------------------------------------------------------------------------- */

.site-header {
    --site-header--padding: space(16);
    --site-header--nav-gap: space(18);
    /* Read by scripts.js: the dialog closes once the nav shows inline */
    --site-header--breakpoint: theme('screens.md');

    position: relative;
    z-index: var(--z-index-site-header);

    @media (width >= theme('screens.md')) {
        --site-header--padding: space(24);
    }

    &:where(.site-header--hero) {
        position: absolute;
        inset: var(--wp-admin--admin-bar--height, 0px) 0 auto;
    }
}

.site-header__bar,
.site-header__dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: space(24);

    @media (width >= theme('screens.md')) {
        align-items: flex-start;
    }
}

.site-header__bar {
    padding: var(--site-header--padding);
}

.site-header__wordmark {
    @apply type-h3;

    display: inline-block;
    margin: 0;
    line-height: 1;
}

/* The wordmark is the <h1> on the hero variant (the front page has no other
   heading-one); the link inside, or the wordmark itself elsewhere, is the link */
a.site-header__wordmark,
.site-header__wordmark-link {
    @apply display-link;

    display: inline-block;
}

/* Inline nav, md and up */
.site-header__nav {
    @media (width < theme('screens.md')) {
        display: none;
    }

    .menu-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: var(--site-header--nav-gap);
    }
}

.site-header__nav,
.site-header__menu {
    a {
        @apply display-link;

        display: inline-flex;
        align-items: center;
    }

    .menu-item--current > .menu-item__wrap a {
        color: var(--display-link--color-faded);
    }
}

.site-header__nav a {
    @apply type-h5;

    min-height: space(24);
}

/* "Menu" and "Close" buttons, below md only */
.site-header__toggle {
    @apply type-h5;

    display: inline-flex;
    align-items: center;
    min-width: space(44);
    min-height: space(44);
    color: var(--color-foreground);

    @media (width >= theme('screens.md')) {
        display: none;
    }
}

/* Full-screen menu dialog, below md */
.site-header__dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--site-header--padding);
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;

    &[open] {
        display: flex;
        flex-direction: column;
        gap: space(40);
    }

    &::backdrop {
        background: transparent;
    }

    @media (prefers-reduced-motion: no-preference) {
        opacity: 1;
        transition: opacity 200ms ease-out;

        @starting-style {
            &[open] {
                opacity: 0;
            }
        }
    }
}

/* The page behind the open menu does not scroll */
html:has(.site-header__dialog[open]) {
    overflow: hidden;
}

.site-header__menu {
    .menu-list {
        display: grid;
        gap: space(16);
    }

    a {
        @apply type-h4;

        min-height: space(44);
    }
}
