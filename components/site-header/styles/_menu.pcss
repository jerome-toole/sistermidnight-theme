.site-header__menu {
    --menu-item--gap: space(24);

    @media (width >= theme('screens.site-header')) {
        --menu-item--gap: space(28);
    }

    a {
        font-family: var(--font-rework);
        font-size: rem(14px);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-warm-black);
        text-decoration: none;
        transition: color var(--transition--duration) var(--transition--ease);

        &:hover,
        &:focus {
            color: var(--colorwarm-black);
        }
    }

    .menu__inner {
        display: flex;
    }

    .menu-list {
        display: flex;
        flex-direction: column;
        gap: var(--menu-item--gap);

        @media (width >= theme('screens.site-header')) {
            flex-direction: row;
            align-items: center;
        }
    }

    .menu-item {
        display: block;

        &.menu-item--current > .menu-item__wrap a {
            text-decoration: underline;
            text-underline-offset: 4px;
        }
    }

    &--mobile {
        a {
            font-size: rem(24px);
        }

        .menu-list {
            --menu-item--gap: space(20);
        }
    }
}
