.site-header__menu {
    --menu-item--gap: space(24);

    @media (width >= theme('screens.site-header')) {
        --menu-item--gap: space(28);
    }

    a {
        @apply type-h2;
        @apply link--2;

        text-underline-offset: 0.3em;

        &:hover,
        &:focus {
            text-decoration: none;
        }

        @media (width >= theme('screens.site-header')) {
            font-size: rem(18px);
        }
    }

    .menu__inner {
        display: flex;
    }

    .menu-list {
        display: flex;
        flex-direction: column;
        gap: var(--menu-item--gap);

        @media (width >= theme('screens.site-header')) {
            flex-direction: row;
            align-items: center;
        }
    }

    .menu-item {
        display: block;

        &.menu-item--current > .menu-item__wrap a {
            text-decoration: underline;
        }
    }

    &--mobile {
        a {
            font-size: rem(24px);
        }

        .menu-list {
            --menu-item--gap: space(20);
        }
    }
}
