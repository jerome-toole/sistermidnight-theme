/* ---------------------------------------------------------------------------
 * Site footer
 *
 * Dark-umber context. Full-width dancers strip, then two rows: footer nav +
 * social icons left with the address right; supporter logos left with the
 * legal text right. Below md the strip is cropped to a fixed height and the
 * columns stack.
 * ------------------------------------------------------------------------- */

.site-footer {
    --site-footer--padding: space(16);
    --site-footer--strip-height: space(160);

    padding-top: var(--site-footer--padding);

    @media (width >= theme('screens.md')) {
        --site-footer--padding: space(24);
        --site-footer--strip-height: auto;
    }
}

/* Decorative strip: inline SVG filled with the context foreground. Below md it
 * is cropped to a fixed height (centred, overflow hidden) rather than scaled. */
.site-footer__strip {
    display: flex;
    justify-content: center;
    height: var(--site-footer--strip-height);
    overflow: hidden;
    pointer-events: none;

    svg {
        display: block;
        flex: none;
        width: 100%;
        max-width: none;
        height: auto;

        @media (width < theme('screens.md')) {
            width: auto;
            height: 100%;
        }
    }

    svg * {
        fill: currentColor;
    }
}

.site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: space(34);
    padding: space(40) var(--site-footer--padding) var(--site-footer--padding);
}

.site-footer__top,
.site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: space(34);

    @media (width >= theme('screens.md')) {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
    }
}

.site-footer__bottom {
    @media (width >= theme('screens.md')) {
        align-items: flex-end;
    }
}

.site-footer__menus {
    display: flex;
    flex-direction: column;
    gap: space(16);
}

.site-footer__nav {
    .menu-list {
        display: flex;
        flex-direction: column;
        gap: space(12);
    }

    a {
        @apply type-small link link--2 link--foreground;

        display: inline-flex;
        align-items: center;
        min-height: space(24);
    }
}

.site-footer__location {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: space(10);
}

.site-footer__address {
    @apply type-body margin-trim;

    font-style: normal;
}

.site-footer__map-link {
    @apply type-small link link--2 link--foreground;

    display: inline-flex;
    align-items: center;
    gap: space(8);
    min-height: space(24);
}

.site-footer__supporters {
    display: flex;
    flex-direction: column;
    gap: space(8);
}

.site-footer__supporters-label {
    @apply type-small;

    margin: 0;
}

.site-footer__logos {
    @apply list-reset-hard;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: space(16);
}

/* Logos are flattened to a light silhouette: brightness(0) keeps only the
 * alpha, invert lifts it to white and the opacity settles it towards the
 * warm-sand foreground. Logos need transparent backgrounds. */
.site-footer__logo {
    a {
        display: block;
    }

    img {
        display: block;
        width: auto;
        max-width: space(160);
        height: auto;
        max-height: space(40);
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }
}

.site-footer__legal {
    @apply type-small margin-trim;

    max-width: space(616);

    @media (width >= theme('screens.md')) {
        text-align: right;
    }

    a {
        @apply link link--2 link--foreground;
    }
}
