.site-footer {
    --link--color: var(--color-foreground);
    --link--color-hover: var(--color-foreground);

    position: relative;
    padding-top: space(16);
    padding-bottom: space(16);

    @media (min-width: theme('screens.md')) {
        padding-top: space(24);
    }
}

.site-footer__inner {
    @apply content-width-fluid-lg;

    position: relative;
}

.site-footer__main {
    display: flex;
    flex-direction: column;
    gap: space(10);
    margin-bottom: space(24);

    @media (min-width: theme('screens.md')) {
        flex-direction: row;
        justify-content: space-between;
        gap: space(8);
        margin-bottom: space(32);
    }
}

.site-footer__left {
    display: flex;
    flex-direction: column;
    gap: space(24);

    .social-icons {
        --grid--column-gap: space(3);

        display: flex;
        flex-flow: row wrap;
        align-items: center;
    }
}

.site-footer__right {
    display: flex;
    flex-direction: column;
    gap: space(24);

    @media (min-width: theme('screens.md')) {
        align-items: flex-end;
        text-align: right;
        flex-shrink: 0;
    }
}

.site-footer__menu {
    .menu__inner {
        @apply list-reset-hard;

        display: flex;
        flex-direction: column;
        gap: space(1);
    }

    .menu-list {
        display: flex;
        flex-direction: column;
        gap: space(1);
    }

    a {
        @apply type-small link--2;
    }
}

.site-footer__address {
    @apply type-small margin-trim;

    a {
        @apply link--2;
    }
}

.site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: space(10);
    align-items: flex-start;
    margin-bottom: space(24);

    @media (min-width: theme('screens.md')) {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
        gap: space(8);
    }
}

.site-footer__meta {
    display: flex;
    flex-direction: column;
    gap: space(1);

    @media (min-width: theme('screens.md')) {
        align-items: flex-end;
        text-align: right;
    }
}

.site-footer__legal {
    @apply type-small margin-trim;
}

.site-footer__copyright {
    @apply type-small margin-trim;

    a {
        @apply link--2;
    }
}

.site-footer__supporters {
    display: flex;
    flex-direction: column;
    gap: space(3);
}

.site-footer__supporters-label {
    @apply type-small;
    margin-bottom: space(8);
}

.site-footer__images {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    align-items: center;
    max-width: 600px;
}

.site-footer__image {
    height: 40px;
    width: auto;

    @media (min-width: theme('screens.md')) {
        height: 40px;
    }

    img {
        height: 100%;
        width: auto;
    }
}

.site-footer__illustration {
    width: 100%;
    pointer-events: none;

    img,
    svg {
        display: block;
        width: 100%;
        height: auto;
    }
}
