.site-footer {
    --link--color: var(--color-foreground);
    --link--color-hover: var(--color-foreground);

    position: relative;
    padding-top: space(16);
    padding-bottom: space(8);

    @media (min-width: theme('screens.md')) {
        padding-top: space(24);
    }
}

.site-footer__inner {
    @apply content-width-fluid-lg;

    position: relative;
}

.site-footer__main {
    display: grid;
    gap: space(12);
    padding-bottom: space(12);

    @media (min-width: theme('screens.sm')) {
        grid-template-columns: 1fr 1fr;
        gap: space(8);
    }

    @media (min-width: theme('screens.md')) {
        padding-bottom: space(16);
    }
}

.site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: space(6);

    .site-footer__text {
        @apply type-small margin-trim;

        a {
            @apply link--2;
        }
    }

    .social-icons {
        --grid--column-gap: space(6);

        display: flex;
        flex-flow: row wrap;
        align-items: center;
    }
}

.site-footer__links {
    display: flex;
    flex-direction: column;
    gap: space(6);

    @media (min-width: theme('screens.sm')) {
        align-items: flex-end;
        text-align: right;
    }
}

.site-footer__menu {
    .menu__inner {
        @apply list-reset-hard;

        display: flex;
        flex-direction: column;
        gap: space(2);
    }

    .menu-list {
        display: flex;
        flex-direction: column;
        gap: space(2);
    }

    a {
        @apply type-small link--2;
    }
}

.site-footer__copyright {
    @apply type-small margin-trim;

    color: var(--color-warm-grey);
}

.site-footer__legal {
    @apply type-small margin-trim;

    max-width: 50rem;
    padding-top: space(8);
    border-top: 1px solid var(--color-warm-black);
    color: var(--color-warm-grey);

    a {
        @apply link--2;
    }
}

.site-footer__illustration {
    width: 100%;
    pointer-events: none;

    img,
    svg {
        display: block;
        width: 100%;
        height: auto;
    }
}

.site-footer__images {
    --grid--columns: 2;

    width: 100%;
    max-width: 17.5rem; /* 280px */
    justify-content: flex-end;
}

.site-footer__image {
    aspect-ratio: 28 / 13;

    > * {
        object-fit: contain;
    }
}
