{
    "key": "group_component_page_navigation",
    "title": "Block - Page Navigation",
    "fields": [
        {
            "key": "field_page_navigation_links",
            "label": "Links",
            "name": "links",
            "type": "repeater",
            "instructions": "Add anchor links to page sections",
            "required": 1,
            "collapsed": "field_page_navigation_label",
            "min": 1,
            "max": 0,
            "layout": "table",
            "button_label": "Add Link",
            "rows_per_page": 20,
            "sub_fields": [
                {
                    "key": "field_page_navigation_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text",
                    "instructions": "Display text for the link",
                    "required": 1,
                    "placeholder": "e.g. Our Team",
                    "parent_repeater": "field_page_navigation_links"
                },
                {
                    "key": "field_page_navigation_anchor",
                    "label": "Anchor",
                    "name": "anchor",
                    "type": "text",
                    "instructions": "Target section ID (without #)",
                    "required": 1,
                    "placeholder": "e.g. team",
                    "parent_repeater": "field_page_navigation_links"
                }
            ]
        },
        {
            "key": "field_page_navigation_sticky",
            "label": "Sticky",
            "name": "sticky",
            "type": "true_false",
            "instructions": "Make navigation sticky when scrolling",
            "required": 0,
            "default_value": 0,
            "ui": 1,
            "ui_on_text": "Yes",
            "ui_off_text": "No"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "theme/page-navigation"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
