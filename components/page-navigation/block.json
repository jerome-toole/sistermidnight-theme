{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "theme/page-navigation",
    "title": "Page Navigation",
    "category": "theme-blocks",
    "icon": "list-view",
    "keywords": [
        "navigation",
        "anchor",
        "jump",
        "links",
        "toc",
        "table of contents"
    ],
    "acf": {
        "blockVersion": 3,
        "mode": "preview",
        "postTypes": [
            "page",
            "gust-template"
        ],
        "renderCallback": "Gust\\Components\\PageNavigation::renderBlock"
    },
    "supports": {
        "anchor": true,
        "align": [
            "wide",
            "full"
        ],
        "color": {
            "background": true,
            "text": false,
            "gradients": false
        }
    }
}
