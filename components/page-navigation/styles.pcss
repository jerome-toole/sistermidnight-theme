:where(.page-navigation) {
    padding-block: var(--space-md);
}

:where(.page-navigation--sticky) {
    position: sticky;
    top: var(--header-height, 60px);
    z-index: 10;
    background: var(--color-background, var(--color-white));
}

:where(.page-navigation__list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
}

:where(.page-navigation__item) {
    position: relative;
}

:where(.page-navigation__link) {
    display: inline-block;
    padding-block: var(--space-2xs);
    color: inherit;
    text-decoration: none;
    font-size: var(--type-small);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    transition: opacity 150ms ease;
}

:where(.page-navigation__link:hover),
:where(.page-navigation__link:focus) {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.25em;
}

/* Smooth scroll behavior for anchor targets */
@media (prefers-reduced-motion: no-preference) {
    :root:has(.page-navigation) {
        scroll-behavior: smooth;
    }
}
