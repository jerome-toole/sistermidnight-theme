/* ---------------------------------------------------------------------------
 * Page header
 *
 * Vertical page title in the left gutter (top-to-bottom from md), then the two-half content layout:
 * illustration (420px) or image (410×607) in the left half, intro copy in
 * the right half. No background of its own: it sits on the page colour.
 *
 * Below md the title is a normal horizontal heading above the intro, and the
 * media follows the intro (illustration 60% wide, image full width).
 * ------------------------------------------------------------------------- */

.page-header {
    --page-header--padding-block: spaceFluid(40, 78);
    --page-header--gap: spaceFluid(24, 32);
    --page-header--illustration-size: spaceFluid(240, 420);
    --page-header--image-width: space(410);
    --page-header--image-ratio: 410 / 607;
    --page-header--image-align-width: space(440); /* Section's left-half image: the header image shares its left edge */

    padding-block: var(--page-header--padding-block);
    padding-inline: var(--container-padding);
}

.page-header__inner {
    container-type: inline-size; /* content-layout--beside-label measures the text column from it */
    display: grid;
    gap: var(--page-header--gap);
    grid-template-columns: minmax(0, 1fr);

    @media (width >= theme('screens.md')) {
        grid-template-columns: auto minmax(0, 1fr);
        align-items: start;
    }
}

.page-header__label {
    @apply type-h2;
    @apply vertical-label;

    margin: 0;
}

.page-header__layout {
    align-items: start;
}

.page-header__intro {
    @apply type-large;
    @apply margin-trim;

    > * + * {
        margin-top: var(--space-base);
    }

    /* The accent link colour fails contrast on dark-umber; links take the text colour */
    a {
        color: var(--color-foreground);
        text-decoration: underline;
        text-underline-offset: 0.15em;

        &:hover {
            text-decoration-thickness: 2px;
        }
    }
}

.page-header__media {
    display: flex;
    justify-content: center;

    /* Below md the media follows the intro */
    @media (width < theme('screens.md')) {
        order: 1;
    }
}

.page-header--image .page-header__media {
    @media (width >= theme('screens.md')) {
        justify-content: flex-start;
        padding-inline-start: max(0px, (100% - var(--page-header--image-align-width)) / 2);
    }
}

.page-header--illustration .page-header__media {
    @media (width < theme('screens.md')) {
        justify-content: flex-start;
    }
}

.page-header__illustration {
    --illustration--size: var(--page-header--illustration-size);

    color: var(--color-foreground);

    @media (width < theme('screens.md')) {
        --illustration--size: 60%;
    }
}

.page-header__img {
    display: block;
    width: 100%;
    max-width: var(--page-header--image-width);
    height: auto;
    aspect-ratio: var(--page-header--image-ratio);
    object-fit: cover;

    /* Spec: full width below md */
    @media (width < theme('screens.md')) {
        max-width: none;
    }
}
