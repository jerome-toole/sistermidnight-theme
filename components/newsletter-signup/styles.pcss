:where(.newsletter-signup) {
    padding-block: var(--space-lg);
}

:where(.newsletter-signup__heading) {
    margin-bottom: var(--space-sm);
}

:where(.newsletter-signup__form) {
    max-width: 28rem;
}

:where(.newsletter-signup__input-group) {
    gap: var(--space-2xs);
}

:where(.newsletter-signup__message) {
    margin-top: var(--space-xs);
    font-size: var(--type-small);

    &[hidden] {
        display: none;
    }
}

:where(.newsletter-signup__message--success) {
    color: var(--color-teal-green);
}

:where(.newsletter-signup__message--error) {
    color: var(--color-burnt-orange);
}

:where(.newsletter-signup--loading) {
    .newsletter-signup__form {
        opacity: 0.6;
        pointer-events: none;
    }
}
