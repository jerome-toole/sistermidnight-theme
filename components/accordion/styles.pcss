.accordion {
    --accordion--btn--size: 2.5rem;
    --accordion--icon--size: 0.875rem;

    padding-block: var(--space-lg);

    :where(.accordion__header) {
        @apply margin-trim;

        margin-bottom: var(--space-md);
    }

    :where(.accordion__heading) {
        max-width: var(--heading--max-width);
    }

    :where(.accordion__items) {
        border-top: var(--border--1);
    }
}

.accordion__item {
    border-bottom: var(--border--1);

    :where(.accordion__item__heading) {
        padding: 0;
        margin: 0;
        font-family: var(--font-rework), system-ui, sans-serif;
        font-size: var(--type-base);
        font-weight: 500;
    }

    :where(.accordion__item__header) {
        @apply button-reset;

        display: grid;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding-block: spaceFluid(16, 20);
        margin: 0;
        background-color: transparent;
        color: var(--color-foreground);
        column-gap: space(16);
        cursor: pointer;
        grid-template-areas: 'content button';
        grid-template-columns: 1fr var(--accordion--btn--size);
        text-align: left;

        @media (hover: hover) {
            &:hover {
                &::after {
                    background-color: var(--color-orange);
                }
            }
        }

        &:focus-visible {
            @apply focus--1;
        }

        &[aria-expanded='true'] {
            &::after {
                transform: rotate(180deg);
            }
        }

        &::after {
            display: block;
            width: var(--accordion--btn--size);
            height: var(--accordion--btn--size);
            background-color: var(--color-foreground);
            border-radius: 50%;
            content: '';
            grid-area: button;
            mask-image: url('/images/icons/chevron-down.svg');
            mask-position: center;
            mask-repeat: no-repeat;
            mask-size: var(--accordion--icon--size);
            transition: transition(transform, background-color);
        }
    }

    :where(.accordion__item__panel) {
        overflow: hidden;

        :where(.accordion__item__panel-inner) {
            @apply margin-trim;

            max-width: 65ch;
            padding-bottom: spaceFluid(20, 32);
            font-size: var(--type-base);
            line-height: 1.6;
        }
    }
}
