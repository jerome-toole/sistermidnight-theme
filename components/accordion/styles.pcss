.accordion {
    --accordion--items--border-y: var(--border-width--s) solid hsla(var(--color-off-white--hsl), 0.15);
    --accordion--btn--size: 2.1875rem; /* 35px */
    --accordion--icon--size: 0.75rem; /* 12px */

    :where(.accordion__header) {
        @apply margin-trim;

        margin-bottom: var(--block--header--margin-bottom);
    }

    :where(.accordion__heading) {
        max-width: var(--heading--max-width);
    }

    :where(.accordion__items) {
        border-top: var(--accordion--items--border-y);
    }
}

.accordion__item {
    border-bottom: var(--border--1);

    + .accordion__item {
        margin-top: space(20);
    }

    :where(.accordion__item__heading) {
        @apply content-width-2xs;

        padding: 0;
        margin: 0;
    }

    :where(.accordion__item__header) {
        @apply button-reset;
        @apply btn--ghost;

        display: grid;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        padding-bottom: spaceFluid(16, 20);
        margin: 0;
        background-color: transparent;
        color: var(--color-foreground);
        column-gap: space(12);
        grid-template-areas: 'content button';
        grid-template-columns: 1fr var(--accordion--btn--size);
        text-align: left;

        @media (hover: hover) {
            &:hover {
                &::before {
                    background-color: var(--btn--background-color--hover);
                }

                &::after {
                    background-color: var(--btn--color-hover);
                }
            }
        }

        &:focus-within:focus-visible {
            &::before {
                background-color: var(--btn--background-color--hover);
            }

            &::after {
                background-color: var(--btn--color-hover);
            }
        }

        &[aria-expanded='true'] {
            &::after {
                transform: rotate(180deg);
            }
        }

        &::before,
        &::after {
            display: block;
            width: var(--accordion--btn--size);
            height: var(--accordion--btn--size);
            content: '';
            grid-area: button;
        }

        &::before {
            border-radius: var(--border-radius--s);
        }

        &::after {
            background-color: var(--color-hb-warm-grey);
            content: '';
            mask-image: url('/images/icons/chevron-down.svg');
            mask-position: center;
            mask-repeat: no-repeat;
            mask-size: var(--accordion--icon--size);
            transition: transition(transform);
        }
    }

    :where(.accordion__item__panel) {
        overflow: hidden;

        :where(.accordion__item__panel-inner) {
            @apply margin-trim;

            max-width: var(--container-xs);
            padding-bottom: spaceFluid(20, 24);
        }
    }
}
